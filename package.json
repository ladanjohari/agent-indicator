{
  "name": "agent-indicator",
  "version": "0.5.0",
  "description": "When an agent needs a person, this is the interface. React approval UI for when an agent spends money, sends messages or reaches private data. Works with Vercel's AI SDK out of the box.",
  "keywords": [
    "ai-sdk",
    "vercel-ai-sdk",
    "approval",
    "human-in-the-loop",
    "hitl",
    "tool-approval",
    "agent-ui",
    "agentic",
    "agent",
    "agent-state",
    "ai",
    "llm",
    "react",
    "react-components",
    "components",
    "status-indicator",
    "ui",
    "typescript"
  ],
  "license": "MIT",
  "author": "Ladan Johari",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ladanjohari/agent-indicator.git"
  },
  "bugs": {
    "url": "https://github.com/ladanjohari/agent-indicator/issues"
  },
  "homepage": "https://ladanjohari.com/agent-indicator/",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ai-sdk": {
      "types": "./dist/ai-sdk/index.d.ts",
      "import": "./dist/ai-sdk.js"
    },
    "./styles.css": "./dist/agent-indicator.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "dev:docs": "vite --config vite.docs.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:docs": "vite build --config vite.docs.config.ts",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "oxlint": "^1.77.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
