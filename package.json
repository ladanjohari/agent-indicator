{
  "name": "agent-state-ui",
  "version": "0.0.0",
  "description": "React components for AI agent state: status, approval, sessions, and activity.",
  "keywords": [
    "react",
    "agent",
    "ai",
    "agent-state",
    "status-indicator",
    "ui",
    "components",
    "typescript"
  ],
  "license": "MIT",
  "author": "Ladan Johari",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ladanjohari/agent-state-ui.git"
  },
  "bugs": {
    "url": "https://github.com/ladanjohari/agent-state-ui/issues"
  },
  "homepage": "https://github.com/ladanjohari/agent-state-ui#readme",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.10.1",
    "@testing-library/react": "^16.4.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^28.0.1",
    "oxlint": "^1.75.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.0.10"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
